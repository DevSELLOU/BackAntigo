{
  "name": "sellou-api",
  "version": "0.0.1",
  "description": "",
  "author": "Epicora Software House",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/src/main",
    "start:dev": "nest start --watch --entryFile src/main",
    "start:debug": "nest start --debug --watch --entryFile src/main",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "start:homologacao": "node scripts/start-homologacao.cjs",
    "seed:homologacao": "node scripts/seed-homologacao.cjs",
    "test:seed:homologacao": "node --test tests/seed-homologacao.test.cjs",
    "validate:homologacao": "node scripts/validate-homologacao.cjs"
  },
  "dependencies": {
    "@nestjs/common": "10.0.0",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.0.0",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.0.0",
    "@nestjs/sequelize": "10.0.1",
    "@nestjs/swagger": "7.4.2",
    "@types/express-rate-limit": "5.1.3",
    "aws-sdk": "2.1692.0",
    "bcrypt": "5.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "exceljs": "^4.4.0",
    "express-rate-limit": "8.3.2",
    "fs-extra": "11.2.0",
    "handlebars": "4.7.8",
    "json2csv": "6.0.0-alpha.2",
    "nodemailer": "7.0.5",
    "papaparse": "5.5.3",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.13.1",
    "puppeteer": "23.5.3",
    "sanitize-html": "^2.17.6",
    "sequelize": "6.37.3",
    "sequelize-typescript": "2.1.6"
  },
  "devDependencies": {
    "@nestjs/cli": "10.0.0",
    "@nestjs/schematics": "10.0.0",
    "@nestjs/testing": "10.0.0",
    "@types/express": "4.17.17",
    "@types/jest": "29.5.2",
    "@types/node": "20.3.1",
    "@types/nodemailer": "6.4.17",
    "@types/passport-jwt": "4.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/sequelize": "4.28.20",
    "@types/supertest": "6.0.0",
    "@typescript-eslint/eslint-plugin": "6.0.0",
    "@typescript-eslint/parser": "6.0.0",
    "eslint": "8.42.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-prettier": "5.0.0",
    "jest": "29.5.0",
    "prettier": "3.0.0",
    "source-map-support": "0.5.21",
    "supertest": "6.3.3",
    "ts-jest": "29.1.0",
    "ts-loader": "9.4.3",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests/",
      "<rootDir>/src/"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1",
      "^sanitize-html$": "<rootDir>/tests/mocks/sanitize-html.js"
    }
  }
}
