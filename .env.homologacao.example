APP_ENV=homologacao
NODE_ENV=production
# PORT is provided by Render; do not reuse the frontend port.
PORT=10000
DB_HOST=RENDER_HOMOLOGACAO_INTERNAL_HOST
DB_PORT=5432
DB_USERNAME=sellou_homologacao
DB_DATABASE=sellou_homologacao
DB_PASSWORD=SET_ONLY_IN_RENDER
DB_TLS=true
# Render INTERNAL host only (self-signed). EXTERNAL host: true.
DB_TLS_REJECT_UNAUTHORIZED=false
JWT_SECRET=GENERATE_A_NEW_HOMOLOGACAO_SECRET
JWT_EXPIRES_IN=1h
FRONTEND_URL=https://FRONTEND-HOMOLOGACAO.onrender.com
SEED_HOMOLOGACAO=false
HOMOLOG_ADMIN_PASSWORD=CHOOSE_A_FICTITIOUS_TEST_PASSWORD
